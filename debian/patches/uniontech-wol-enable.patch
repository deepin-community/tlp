--- tlp.orig/tlp.conf.in
+++ tlp/tlp.conf.in
@@ -368,6 +368,15 @@
 
 #WOL_DISABLE=Y
 
+# Enable Wake-on-LAN, ethtool wol mode characters (e.g. g = magic packet,
+# gb = magic + broadcast, mg = multicast + magic). Y is an alias for g.
+# Enabled only if configured; takes effect only when WOL_DISABLE=N.
+# If both WOL_DISABLE=Y and WOL_ENABLE are set, WOL_DISABLE wins and an
+# error message is printed.
+# Default: not set
+
+#WOL_ENABLE=
+
