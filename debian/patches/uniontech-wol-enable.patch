Index: tlp/func.d/05-tlp-func-pm
===================================================================
--- tlp.orig/func.d/05-tlp-func-pm
+++ tlp/func.d/05-tlp-func-pm
@@ -240,6 +240,25 @@ disable_wake_on_lan () {  # disable WOL
     return 0
 }
 
+enable_wake_on_lan () {  # enable WOL per $WOL_ENABLE (ethtool wol mode chars, Y = magic packet)
+    local mode="$WOL_ENABLE"
+
+    if [ "$WOL_DISABLE" = "Y" ]; then
+        [ -n "$WOL_ENABLE" ] && echo_debug "pm" "conflict, WOL_DISABLE=Y wins, WOL_ENABLE=$WOL_ENABLE ignored"
+        return 0
+    fi
+    [ -z "$WOL_ENABLE" ] && return 0
+
+    [ "$mode" = "Y" ] && mode=g
+    get_ethifaces
+    for ei in $_ethifaces; do
+        $ETHTOOL -s "$ei" wol "$mode" > /dev/null 2>&1
+        echo_debug "pm" "enable_wake_on_lan: $ei mode=$mode; rc=$?"
+    done
+
+    return 0
+}
+
