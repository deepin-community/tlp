Index: tlp/func.d/05-tlp-func-pm
===================================================================
--- tlp.orig/func.d/05-tlp-func-pm
+++ tlp/func.d/05-tlp-func-pm
@@ -13,6 +13,7 @@ readonly ETHTOOL=ethtool
 
 readonly PCID=/sys/bus/pci/devices
 readonly PCIDRV=/sys/bus/pci/drivers
+readonly PLATFORMD=/sys/bus/platform/devices
 readonly SLEEPMODE=/sys/power/mem_sleep
 
 # ----------------------------------------------------------------------------
@@ -24,9 +25,9 @@ set_runtime_pm () { # set runtime power
     # $1: 0=ac mode, 1=battery mode
 
     local address class control device driver drv_bl type
+    local enable_devs disable_devs name
     local pci_bl_adr=""
     local pci_bl_drv=""
-    local pci_enable_adr pci_disable_adr
 
     if [ "$1" = "1" ]; then
         control=${RUNTIME_PM_ON_BAT:-}
@@ -34,11 +35,11 @@ set_runtime_pm () { # set runtime power
         control=${RUNTIME_PM_ON_AC:-}
     fi
 
-    # permanent addresses
-    pci_enable_adr=${RUNTIME_PM_ENABLE:-}
-    pci_disable_adr=${RUNTIME_PM_DISABLE:-}
+    # permanent device overrides (PCIe addresses or platform device names)
+    enable_devs=${RUNTIME_PM_ENABLE:-}
+    disable_devs=${RUNTIME_PM_DISABLE:-}
 
-    if [ -z "$control" ] && [ -z "$pci_enable_adr" ] && [ -z "$pci_disable_adr" ] ; then
+    if [ -z "$control" ] && [ -z "$enable_devs" ] && [ -z "$disable_devs" ] ; then
         # quit if completely unconfigured
         echo_debug "pm" "set_runtime_pm($1).not_configured"
         return 0
@@ -92,11 +93,11 @@ set_runtime_pm () { # set runtime power
                 address=${device##/*/0000:}
                 class=$(read_sysf "$device/class")
 
-                if wordinlist "$address" "$pci_enable_adr"; then
+                if wordinlist "$address" "$enable_devs"; then
                     # device should be permanently 'auto' (enabled)
                     write_sysf "auto" "$device/power/control"
                     echo_debug "pm" "set_runtime_pm($1).perm_auto: $device [$class]; rc=$?"
-                elif wordinlist "$address" "$pci_disable_adr"; then
+                elif wordinlist "$address" "$disable_devs"; then
                     # device should be permanently 'on' (disabled)
                     write_sysf "on" "$device/power/control"
                     echo_debug "pm" "set_runtime_pm($1).perm_on: $device [$class]; rc=$?"
@@ -122,6 +123,28 @@ set_runtime_pm () { # set runtime power
         done # for device
     done # for type
 
+    # iterate platform devices, matched by device name (e.g. AMDI0010:00) as
+    # listed in RUNTIME_PM_ENABLE/DISABLE; unlisted platform devices are
+    # never touched
+    if [ -n "$enable_devs$disable_devs" ]; then
+        for device in "$PLATFORMD"/*; do
+            if [ -f "$device/power/control" ]; then
+                # get short device name
+                name=${device##*/}
+
+                if wordinlist "$name" "$enable_devs"; then
+                    # device should be permanently 'auto' (enabled)
+                    write_sysf "auto" "$device/power/control"
+                    echo_debug "pm" "set_runtime_pm($1).perm_auto: $device; rc=$?"
+                elif wordinlist "$name" "$disable_devs"; then
+                    # device should be permanently 'on' (disabled)
+                    write_sysf "on" "$device/power/control"
+                    echo_debug "pm" "set_runtime_pm($1).perm_on: $device; rc=$?"
+                fi
+            fi # if power/control
+        done # for device
+    fi
+
     return 0
 }
 
Index: tlp/tlp.conf.in
===================================================================
--- tlp.orig/tlp.conf.in
+++ tlp/tlp.conf.in
@@ -423,10 +423,15 @@
 
 #RUNTIME_PM_DRIVER_DENYLIST="mei_me nouveau radeon xhci_hcd"
 
-# Permanently enable/disable Runtime PM for listed PCIe device addresses
-# (independent of the power source). This has priority over all preceding
-# Runtime PM settings. Separate multiple addresses with spaces.
-# Use lspci to get the adresses (1st column).
+# Permanently enable/disable Runtime PM for listed devices (independent of
+# the power source). This has priority over all preceding Runtime PM
+# settings. Separate multiple devices with spaces.
+# PCIe devices: use the device address as shown by lspci (1st column).
+# Platform devices (SoC/ACPI, e.g. the AMDI0010 I2C controller found on
+# many AMD laptops): use the device name as shown in
+# /sys/bus/platform/devices/, e.g. "AMDI0010:00". Platform devices are
+# only managed by TLP if listed here; unlisted platform devices are
+# never touched.
 # Default: <none>
 
 #RUNTIME_PM_ENABLE="11:22.3"
